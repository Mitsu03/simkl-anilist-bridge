# Filled in by `npm run auth:simkl` and `npm run auth:anilist`.
# Never commit the real .dev.vars — it holds live tokens.
SIMKL_CLIENT_ID=
SIMKL_ACCESS_TOKEN=
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
ANILIST_ACCESS_TOKEN=

# Shared secret guarding the Worker's HTTP routes. Any long random string.
BRIDGE_TOKEN=

# Optional tuning, mirrored from wrangler.toml [vars].
WRITE_BUDGET=40
ANILIST_MIN_INTERVAL_MS=2400
ALLOW_LOWERING=false
